{
  "version": 2,
  "rewrites": [
    { "source": "/assets/(.*)", "destination": "/landing/assets/$1" },
    { "source": "/social-preview.svg", "destination": "/landing/social-preview.svg" },
    { "source": "/version.json", "destination": "/landing/version.json" },
    { "source": "/", "destination": "/landing/index.html" },
    { "source": "/((?!api/).*)", "destination": "/landing/index.html" }
  ]
}
